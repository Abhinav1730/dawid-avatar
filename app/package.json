{
  "name": "dawid-avatar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:media": "node --env-file=.env.local scripts/train-dawid.mjs",
    "check:tavus": "node --env-file=.env.local scripts/check-tavus.mjs",
    "eval:prepare": "node --env-file=.env.local scripts/prepare-evaluation.mjs",
    "eval:start": "node --env-file=.env.local scripts/start-evaluation.mjs",
    "eval:browser": "node scripts/evaluation-server.mjs",
    "eval:end": "node --env-file=.env.local scripts/end-evaluation.mjs"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.93.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
